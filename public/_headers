# Cloudflare Pages response headers.
# This file is copied verbatim to the deploy root (dist/_headers) at build
# time and applied by Cloudflare's edge. Each rule block starts with a path
# pattern; indented lines below it are "Header-Name: value".
#
# Verify after deploy at https://securityheaders.com and
# https://observatory.mozilla.org — target is A+ on both.

/*
  # --- Content Security Policy ---------------------------------------------
  # default-src 'none' denies everything, then we re-allow only same-origin.
  # No 'unsafe-inline' / 'unsafe-eval' anywhere — that is what earns the A+.
  # If you ever add an inline <script>, a web font, or an external image,
  # this line must change or the browser will block the resource (check the
  # console). Prefer adding a specific source over loosening to 'unsafe-*'.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

  # --- Transport security --------------------------------------------------
  # 2-year HSTS with subdomains + preload. READ BEFORE GOING LIVE: `preload`
  # is a long-term commitment — every subdomain must serve valid HTTPS, and
  # removal from the browser preload list is slow. Safe here because the site
  # is HTTPS-only on Cloudflare, but understand it before submitting to
  # hstspreload.org.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # --- Anti-sniffing / framing / referrer ---------------------------------
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

  # --- Permissions Policy: deny every powerful feature (site uses none) ----
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), usb=()

  # --- Cross-origin isolation (safe: all resources are same-origin) --------
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Hashed, immutable build assets — cache hard for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
